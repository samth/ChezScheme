(import (chezscheme))
(#3%$enable-check-prelex-flags #t)
(define checks 0)
(define (check label got want)
 (set! checks (+ checks 1))
 (unless (equal? got want) (error label "mismatch" got want)))
(define-record-type view (fields v start len))
(define-record-type other (fields v start len))
(define-record-type mutable-view (fields (mutable v) start len))
(define vt (record-type-descriptor view))
(define ot (record-type-descriptor other))
(define mt (record-type-descriptor mutable-view))
(define effects '())
(define (tick x) (set! effects (append effects (list x))) x)
(for-each
 (lambda (level)
  (optimize-level level)
  (let ([f (compile '(lambda (rtd v i)
             (let ([s (let ([s (#3%$record rtd v i (begin (tick 'init) 7))])
                        (tick 'jump) (vector-set! v 0 42) s)])
              (list (#3%$record-ref s 0) (#3%$record-ref s 1) (#3%$record-ref s 2)))))])
   (set! effects '())
   (check 'snapshot-and-effects (f vt (vector 1) 5) '(#(42) 5 7))
   (check 'order effects '(init jump)))
  (let ([f (compile '(lambda (rtd yes v)
             (let ([s (let ([s (if yes (#3%$record rtd v (tick 3) (tick 9)) #f)])
                        (when s (tick 'jump)) s)])
              (if s (list (#3%$record-ref s 1) (#3%$record-ref s 2)) 'none))))])
   (set! effects '()) (check 'optional-absent (f vt #f '#()) 'none)
   (check 'no-unused-initializers effects '())
   (check 'optional-present (f vt #t '#()) '(3 9))
   (check 'optional-order effects '(3 9 jump)))
  (let ([f (compile '(lambda (rtd yes)
             (let ([s (if yes (#3%$record rtd 1 2 3) #f)])
              (if (record? s rtd) (#3%$record-ref s 2) 'absent))))])
   (check 'predicate-yes (f vt #t) 3)
   (check 'predicate-no (f vt #f) 'absent))
  (let ([f (compile '(lambda (rtd yes)
             (let ([s (if yes #f (#3%$record rtd 4 5 6))])
              (if s (#3%$record-ref s 1) 'absent))))])
   (check 'reversed-false (f vt #t) 'absent)
   (check 'reversed-present (f vt #f) 5))
  (let ([f (compile '(lambda (rtd1 rtd2 yes)
             (let ([s (if yes (#3%$record rtd1 1 2 3) (#3%$record rtd2 4 5 6))])
              (list (record? s rtd1) (record? s rtd2) (#3%$record-ref s 1)))))])
   (check 'different-descriptors-a (f vt ot #t) '(#t #f 2))
   (check 'different-descriptors-b (f vt ot #f) '(#f #t 5)))
  (let ([f (compile '(lambda (rtd)
             (let ([s (#3%$record rtd 1 2 3)])
              (#3%$record-set! s 0 9) (#3%$record-ref s 0))))])
   (check 'mutation-reject (f mt) 9))
  (let ([f (compile '(lambda (rtd)
             (let ([s (#3%$record rtd 1 2 3)]) (lambda () s))))])
   (let ([g (f vt)]) (check 'escape (view-start (g)) 2)
     (check 'closure-identity (eq? (g) (g)) #t)))
  (let ([f (compile '(lambda (rtd)
             (let ([s (let ([s (#3%$record rtd 1 2 3)])
                        (tick (lambda () s)) s)]) (#3%$record-ref s 2))))])
   (set! effects '()) (check 'producer-escape (f vt) 3)
   (check 'escaped-object (view-start ((car effects))) 2))
  (let ([f (compile '(lambda (rtd)
             (let ([s (#3%$record rtd 1 2 (error 'expected "unused field"))])
              (#3%$record-ref s 0))))])
   (check 'unused-exception (guard (e [else 'raised]) (f vt)) 'raised)))
 '(0 2 3))

;; A legal call may never take the raw record-access branch. Optional pairs
;; must be rejected as record candidates without throwing during compilation.
(define (never) #f)
(for-each
 (lambda (access)
  (let ([f (compile `(lambda (yes)
                      (let ([p (if yes (cons 1 2) #f)])
                        (if (never) ,access 17))))])
   (check 'dormant-record-access (f #f) 17)
   (check 'dormant-record-access (f #t) 17)))
 '((#3%$object-ref 'scheme-object p 1) (#3%$record-ref p 0)))

(printf "passed ~s library SRA semantic checks\n" checks)
